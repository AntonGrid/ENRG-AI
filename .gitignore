# Python
.venv/
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Environment
.env

# Logs
*.log

# Runtime data: a run's output and the venue's history are not the repository's source.
data/*
# ...except the frozen bars the reproducibility check replays. They are what makes "the other
# machine got the same table" checkable after the venue's window has moved on, and they are
# about 280 kB for one pair, which is cheaper than a claim nobody can test.
!data/frozen/

# Deploy files: the operator's `.env` is private, the example is not
!.env.example

# Cache
.pytest_cache/
.cache/

# Connected projects (symlinks to the workspace, see scripts/link_projects.sh)
projects/*
!projects/.gitkeep

# OS
.DS_Store
Thumbs.db