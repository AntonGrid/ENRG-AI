# ENRG-AI — the operator's values.
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored and is the only place a secret is written. Nothing below
# has a default that could move value: a missing variable is an error with a
# name (`TestnetNotConfigured`), never a silent fallback to a public endpoint.
# An exported variable always wins over this file.

# ── which chain? (optional, but the fast way to switch networks) ────────────
# The venue itself reads `TESTNET_*` only. Naming a chain here lets the variable
# names your node provider hands you answer for the canonical ones, and supplies
# the chain id when it is not written down:
#
#   arbitrum → 42161 (Arbitrum One)      base → 8453
#   polygon  → 137  (Polygon PoS)        sepolia → 11155111
#
# A profile is a *spelling, not a permission*. Arbitrum, Base and Polygon are
# chains where credits are money: signing there needs TESTNET_ALLOW_MAINNET=1
# **and** `allow_mainnet=True` in the calling code. Both yeses, or the venue
# refuses to connect. Leaving this empty means "read TESTNET_* and nothing else".
TESTNET_PROFILE=

# ── the chain (agent/physics/real_testnet_provider.py) ──────────────────────
# Required by any real venue. Read-only without a signer. This is where the node
# provider's endpoint goes — it usually contains an API key, so it is a secret.
#   Arbitrum One:     https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
#   Arbitrum Sepolia: https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
#   Sepolia:          https://sepolia.example/v3/YOUR_KEY_HERE
TESTNET_RPC_URL=

# The signer. Optional — leave it empty and the venue can only read.
# A dedicated key, funded with the minimum ($50 and no more), never the deployer's.
# Losing it should be annoying, not fatal; anyone who sees it owns the funds.
TESTNET_PRIVATE_KEY=

# Alternative to a key: an address the *node* signs for (Anvil, Hardhat).
# TESTNET_UNLOCKED_ACCOUNT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Asserted against the node's own chain id; a mismatch refuses to connect.
# 42161 = Arbitrum One, 421614 = Arbitrum Sepolia, 11155111 = Sepolia.
# Leave empty to accept whatever the node reports (recommended: the arithmetic
# of "the node is chain X" is then done by the node, not by a copied constant).
TESTNET_CHAIN_ID=

# The operator's address book — the whitelist. Without it the book is empty
# and nothing can be staked into. File path, or the same JSON inline.
TESTNET_PROTOCOLS_FILE=book.json
# TESTNET_PROTOCOLS={"protocols": []}

# TESTNET_DECIMALS=6              # credits per token unit (USDC-like)
# TESTNET_LOOKBACK=5000           # blocks scanned for a record
# TESTNET_RECEIPT_TIMEOUT=120     # seconds to await a receipt
# TESTNET_BLOCK_TIMEOUT=30        # seconds to await a block
# TESTNET_ABI_FILE=               # override the built-in vault ABI

# One half of the two-key lock on real money — and an L2 is real money. The
# other half is `allow_mainnet=True` in code: `docker compose up` cannot open
# this by itself.
TESTNET_ALLOW_MAINNET=0

# ── Arbitrum One: the same three values, under the provider's own names ─────
# Read only when `TESTNET_PROFILE=arbitrum` is set and the `TESTNET_*` name above
# is empty; the canonical name always wins. A bare `RPC_URL`/`PRIVATE_KEY` is
# deliberately NOT an alias — a stray variable from another project must never
# be able to become a signer.
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
# ARBITRUM_PRIVATE_KEY=
# ARBITRUM_CHAIN_ID=42161

# ── signing (agent.signals --sign, agent.physics --sign) ────────────────────
# Base64 Ed25519 seed, generated on the box, never reused across deployments.
# AXIS_AI_SIGNING_KEY=

# ── runtime ─────────────────────────────────────────────────────────────────
# ENRG_CACHE_DIR=.cache           # the market cache (set to /data/.cache in Docker)
TRAIN_INTERVAL=3600               # seconds between self-training cycles (compose only)
